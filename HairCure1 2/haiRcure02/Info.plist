<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>$(GOOGLE_CLIENT_ID)</string>
	<key>OPENROUTER_API_KEY</key>
	<string>$(OPENROUTER_API_KEY)</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SUPABASE_URL</key>
	<string>$(SUPABASE_URL)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>We need camera access to scan product ingredient lists and analyze compatibility with your scalp.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>This app reads your water intake and sleep data to display hydration and wellness insights.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>This app writes water intake data to the Health app to track your hydration.</string>
</dict>
</plist>
